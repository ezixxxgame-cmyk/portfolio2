# Скопируйте в .env для локального запуска. На Vercel те же переменные задаются в Settings → Environment Variables.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Любая длинная случайная строка (латиница, цифры, _ и -). Та же строка передаётся в setWebhook как secret_token.
TELEGRAM_WEBHOOK_SECRET=

# Telegram ID администраторов через запятую. Узнать свой ID: напишите боту /id.
ADMIN_IDS=

# Upstash Redis. При подключении через Vercel → Storage → Upstash переменные появятся сами.
KV_REST_API_URL=
KV_REST_API_TOKEN=
